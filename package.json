{
  "name": "kobby-v2",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:kobby": "turbo run dev --filter=kobby",
    "build:kobby": "turbo run build --filter=kobby",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "tw-animate-css": "^1.2.9",
    "tailwindcss": "^4",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
